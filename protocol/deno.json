{
  "tasks": {
    "sidecar": "deno run --unstable-worker-options --no-prompt --allow-read --allow-write --allow-net --allow-env src/launcher.ts",
    "dev": "deno run --unstable-worker-options --no-prompt --watch --allow-read --allow-write --allow-net --allow-env src/launcher.ts",
    "check": "deno fmt --check && deno lint && deno check --unstable-worker-options src/launcher.ts src/runtime.ts && deno test --unstable-worker-options --allow-read --allow-write --allow-env=Q_DEBUG tests/"
  },
  "lint": {
    "exclude": ["vendor/"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "exclude": ["vendor/"]
  },
  "imports": {
    "@evex/linejs": "jsr:@evex/linejs@^3.5.0",
    "@evex/linejs-types": "jsr:@evex/linejs-types@^3.5.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "opusscript": "npm:opusscript@0.1.1"
  }
}
