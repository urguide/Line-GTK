pkgbase = line-rust-git
	pkgdesc = Unofficial native LINE client for Linux (GTK4 / Libadwaita), git version
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/urguide/line-rust
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	depends = gtk4>=4.14
	depends = libadwaita>=1.5
	depends = ffmpeg
	depends = deno
	depends = hicolor-icon-theme
	optdepends = poppler: PDF preview in media viewer
	optdepends = gst-plugins-good: extra video playback codecs
	optdepends = gst-libav: extra video playback codecs
	provides = line-rust
	conflicts = line-rust
	conflicts = line-gtk
	conflicts = line-gtk-git
	options = !lto
	options = !strip
	source = git+https://github.com/urguide/line-rust.git
	sha256sums = SKIP

pkgname = line-rust-git
