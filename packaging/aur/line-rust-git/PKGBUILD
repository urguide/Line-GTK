# Maintainer: urguide
# Based on the upstream package by MidnightTale <mntale@pm.me>.
pkgname=line-rust-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Unofficial native LINE client for Linux (GTK4 / Libadwaita), git version'
arch=('x86_64' 'aarch64')
url='https://github.com/urguide/line-rust'
license=('GPL-3.0-or-later')
depends=('gtk4>=4.14' 'libadwaita>=1.5' 'ffmpeg' 'hicolor-icon-theme')
makedepends=('cargo' 'deno' 'git')
optdepends=(
  'poppler: PDF preview in media viewer'
  'gst-plugins-good: extra video playback codecs'
  'gst-libav: extra video playback codecs'
)
provides=('line-rust')
conflicts=('line-rust' 'line-gtk' 'line-gtk-git')
options=('!lto' '!strip')
source=("git+https://github.com/urguide/line-rust.git")
sha256sums=('SKIP')

pkgver() {
  cd line-rust
  local ver
  ver="$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)"
  printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd line-rust
  export RUSTUP_TOOLCHAIN=stable
  # Prefer lockfile when present; otherwise resolve deps for this snapshot.
  if [[ -f Cargo.lock ]]; then
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  else
    cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
  fi
}

build() {
  cd line-rust
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  if [[ -f Cargo.lock ]]; then
    cargo build --frozen --release
  else
    cargo build --release
  fi
  ./scripts/build-sidecar.sh
}

package() {
  cd line-rust

  install -Dm755 target/release/line-rust "$pkgdir/usr/bin/line-rust"

  install -d "$pkgdir/usr/share/line-rust"
  cp -a protocol "$pkgdir/usr/share/line-rust/protocol"
  cp -a assets "$pkgdir/usr/share/line-rust/assets"

  rm -rf "$pkgdir/usr/share/line-rust/protocol/node_modules" \
         "$pkgdir/usr/share/line-rust/protocol/.deno" 2>/dev/null || true

  install -Dm644 packaging/io.github.urguide.LineRust.desktop \
    "$pkgdir/usr/share/applications/io.github.urguide.LineRust.desktop"

  for size in 48x48 64x64 128x128 256x256; do
    install -Dm644 "assets/icons/hicolor/${size}/apps/line-rust.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/io.github.urguide.LineRust.png"
    # Keep the legacy name for notification clients and existing launchers.
    install -Dm644 "assets/icons/hicolor/${size}/apps/line-rust.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/line-rust.png"
  done
  install -Dm644 assets/icons/hicolor/scalable/apps/line-rust.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.urguide.LineRust.svg"
  install -Dm644 assets/icons/hicolor/scalable/apps/line-rust.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/line-rust.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
